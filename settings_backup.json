{
  "proxy": "",
  "auto_update": true,

  "base_keymap": "VSCode",

  "icon_theme": "Warm Charmed Icons",

  "ui_font_size": 16,
  "buffer_font_size": 16,

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Aura Dark",
  },

  "autosave": "on_focus_change",

  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  "soft_wrap": "editor_width",

  "relative_line_numbers": true,
  "colorize_brackets": true,
  "cursor_blink": true,

  "current_line_highlight": "all",

  "show_whitespaces": "boundary",

  "hover_popover_enabled": true,
  "show_completions_on_input": true,
  "auto_signature_help": true,

  "use_autoclose": true,
  "use_auto_surround": true,

  "scroll_sensitivity": 1.5,

  "confirm_quit": false,

  "indent_guides": {
    "enabled": true,
  },

  "inlay_hints": {
    "enabled": true,
  },

  "toolbar": {
    "breadcrumbs": true,
  },

  "scrollbar": {
    "show": "auto",
  },

  "project_panel": {
    "auto_reveal_entries": true,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "default_width": 280,
    "dock": "right",
  },

  "outline_panel": {
    "dock": "right",
  },

  "collaboration_panel": {
    "dock": "right",
  },

  "git_panel": {
    "dock": "right",
  },

  "agent": {
    "dock": "right",
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "session": {
    "trust_all_worktrees": true,
  },

  "terminal": {
    "working_directory": "current_project_directory",
    "copy_on_select": true,
    "dock": "bottom",

    "shell": {
      "with_arguments": {
        "program": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["--login"],
      },
    },
  },

  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/.next",
    "**/dist",
    "**/build",
    "**/.vercel",
    "**/coverage",
    "**/.turbo",
  ],
}
